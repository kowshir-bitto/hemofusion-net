# ---- Generated artefacts that must not be versioned ----
# Preprocessing cache (regenerated from the NIfTI volumes in minutes)
outputs/cache/
# Model checkpoints (hundreds of MB; regenerated by run_pipeline.py)
outputs/models/
*.pth
*.pt
*.ckpt

# ---- Run logs ----
# Per-epoch history CSVs are versioned (the training-curve figures need them);
# raw stdout captures are not.
outputs/logs/*.log
nohup.out

