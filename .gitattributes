# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Text formats
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.ipynb   text eol=lf

# Binary — never convert, never diff as text
*.png     binary
*.pdf     binary
*.xlsx    binary
*.docx    binary
*.pth     binary
*.npz     binary
*.nii     binary
*.nii.gz  binary
